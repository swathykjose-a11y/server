# =============================================================================
# Dainty Dazzle Server - Environment Variables
# Copy this file to .env and fill in real values.
# =============================================================================

# Server Configuration
PORT=8787
NODE_ENV=production
APP_URL=https://api.daintydazzle.store
CORS_ORIGIN=https://daintydazzle.store,https://www.daintydazzle.store,https://admin.daintydazzle.store,http://localhost:3000,http://localhost:3001

# PostgreSQL Database (Supabase / Neon / AWS RDS / Local Postgres)
# Supports connection pooling (PgBouncer) for high traffic scalability
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dainty_dazzle?sslmode=prefer

# Upstash Redis (Serverless & Distributed caching, rate-limiting, idempotency locks)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Resend Email (Customer confirmations, admin dropship orders, and developer error alerts)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Dainty Dazzle <orders@daintydazzle.store>
ADMIN_NOTIFICATION_EMAIL=swathykjose@gmail.com
DEVELOPER_ALERT_EMAIL=bhavartheankit@gmail.com

# PhonePe is not used for checkout. Storefront payments are manual UPI.
# Leave these blank unless a PhonePe merchant account is configured.
PHONEPE_ENV=UAT
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_REDIRECT_URL=https://daintydazzle.store/checkout/payment-status
PHONEPE_CALLBACK_URL=https://api.daintydazzle.store/api/payments/phonepe-webhook

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Sentry Monitoring & Error Tracking
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development

# Admin & Internal Security (required, 24+ characters, not a published placeholder)
JWT_SECRET=replace-with-a-long-random-string
ADMIN_API_KEY=replace-with-a-long-random-string
REVALIDATION_SECRET=replace-with-a-long-random-string

# Optional. If the API sits behind a reverse proxy, the proxy sends this header
# together with cf-connecting-ip or x-real-ip. Direct clients cannot set the client IP.
# TRUSTED_PROXY_SECRET=replace-with-a-long-random-string
